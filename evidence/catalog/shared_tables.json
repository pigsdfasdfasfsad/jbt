  "ModuleScript.Bonuses.Source.txt": {
    "fields": {
      "GetBonus": {
        "expression": "function(arg1, arg2, arg3, arg4, arg5, arg6) -- Line 17\n\t\t--[[ Upvalues[1]:\n\t\t\t[1]: module_upvr (readonly)\n\t\t]]\n\t\tlocal Mode = workspace:GetAttribute(\"Mode\")\n\t\tif Mode ~= \"Endless\" then\n\t\t\treturn math.floor(arg1 * arg3 ^ 0.055 * module_upvr[Mode] + 0.5)"
      }
    },
    "array": [
      {
        "expression": "math.floor(math.floor(190 * arg1 ^ 0.17 + 0.5) + 0.5)"
      },
      {
        "expression": "arg2 * 200"
      },
      {
        "expression": "arg2 * 400"
      },
      {
        "expression": "math.floor(1.75 ^ (1 / (workspace:GetAttribute(\"MaxWaves\") - 1)) ^ (arg4 - 1) / 0.01 + 0.5) * 0.01\n\t\tend\n\t\tlocal minimum = math.min(arg1, 27)\n\t\treturn math.floor(minimum * arg3 ^ 0.055 * module_upvr[Mode] + 0.5)"
      },
      {
        "expression": "math.floor(math.floor(190 * minimum ^ 0.17 + 0.5) + 0.5)"
      },
      0,
      0,
      {
        "expression": "math.floor(1.0298915058042881 ^ (math.clamp(arg4, 0, 20) - 1) / 0.01 + 0.5) * 0.01\n\tend"
      }
    ]
  },
